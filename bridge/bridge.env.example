# Скопируйте этот файл в bridge.env и заполните два поля.
# bridge.env НЕ коммитить и не пересылать.

# Учётка Ecovacs Home (регион Poland)
ECOVACS_EMAIL=
ECOVACS_PASSWORD=

# Регион и класс устройства — менять не нужно
ECOVACS_COUNTRY=PL
ECOVACS_CLASS=kduunv

# Как робот будет называться в «Доме с Алисой»
DEVICE_NAME=Пылесос
DEVICE_ROOM=Коридор

# Пароль, который вы введёте один раз при привязке аккаунта в Яндексе
BRIDGE_PASSWORD=

# Необязательно: проверка OAuth-клиента на /auth/token.
# OAUTH_CLIENT_SECRET по умолчанию пуст — проверка секрета отключена.
# Если задать, значение должно совпадать с «Секретом приложения» в навыке.
OAUTH_CLIENT_ID=https://social.yandex.net/
OAUTH_CLIENT_SECRET=
